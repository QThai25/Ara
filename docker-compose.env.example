# Explicit local-development Compose values. Use with:
# `docker compose --env-file docker-compose.env.example up --build`
DOCKER_NODE_ENV=development
DOCKER_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
DOCKER_FRONTEND_URL=http://localhost:5173
DOCKER_BACKEND_URL=http://localhost:4000
DOCKER_PAYOS_ENABLED=false

# These values are public and are embedded into the Vite bundles at build time.
VITE_API_BASE_URL=http://localhost:4000/api
VITE_ADMIN_URL=http://localhost:5174
VITE_CUSTOMER_URL=http://localhost:5173
